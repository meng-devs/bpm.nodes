description: "Sets the value of a variable and provides the value as output"
group: Variable
name: Set
extends: Variable/Variable

edges:
  value:
    description: 'Value to store in the variable'
    direction: input
    type: any
    required: true
  output:
    description: 'The value that was stored (pass-through)'
    direction: output
    type: any
  exec_in:
    description: 'Execution input'
    direction: input
    type: exec
  exec_out:
    description: 'Execution output'
    direction: output
    type: exec

source: |
  -- Determine storage based on scope
  local storage = scope == "global" and global_variables or variables
  
  -- Store the value
  storage[name] = value
  
  -- Output the value (pass-through)
  ${OUTPUT.output = value}
  
  -- Continue execution
  ${EXEC.exec_out}
