description: "Base node for variable operations to store and retrieve values"
group: Variable
name: Variable
extends: Base/Node

theme:
  color: '#2196F3'
  height: 60
  width: 120
  icon: 0xf1c0  # Database icon

edges:
  name:
    description: 'Variable name (must be unique)'
    type: string
    direction: input
    required: true
    value:
      type: string
      default: "var"
  scope:
    description: 'Variable scope (local or global)'
    type: string
    direction: input
    value:
      type: string
      default: "local"
      enum: ["local", "global"]

