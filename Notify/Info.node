description: "Shows an informational notification message"
group: Notify
name: Info
extends: Notify/Notification

theme:
  color: '#3366CC'
  icon: 0xf05a  # Info-circle icon

source: |
  -- Force info type
  type = "info"
  title = title or "Information"
  
  -- Use parent implementation
  local msg = message or ""
  if msg == "" then
    msg = "(Empty notification)"
  end
  
  -- Get the notification type
  local notification_type = "INFO"
  
  -- Get optional title
  local header = title or "Information"
  
  -- Get duration
  local time = duration or 3.0
  
  -- Set color
  local color = "#3366CCF5"
  
  -- Send the notification
  Notify:message(msg, time, color, header, notification_type)
  
  -- Continue execution
  ${EXEC.exec_out}
