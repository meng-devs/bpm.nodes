description: "Shows an error notification message"
group: Notify
name: Error
extends: Notify/Notification

theme:
  color: '#F44336'
  icon: 0xf057  # Times-circle icon (X in circle)

source: |
  -- Force error type
  type = "error"
  title = title or "Error"
  
  -- Use parent implementation
  local msg = message or ""
  if msg == "" then
    msg = "(Empty error notification)"
  end
  
  -- Get the notification type
  local notification_type = "ERROR"
  
  -- Get optional title
  local header = title or "Error"
  
  -- Calculate duration based on message length (errors stay longest)
  local length = string.len(msg)
  local time = math.max(5.0, math.min(10.0, length * 0.1))
  
  -- Set color
  local color = "#F44336F5"
  
  -- Send the notification
  Notify:message(msg, time, color, header, notification_type)
  
  -- Continue execution
  ${EXEC.exec_out}