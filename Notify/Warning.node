description: "Shows a warning notification message"
group: Notify
name: Warning
extends: Notify/Notification

theme:
  color: '#FFA000'
  icon: 0xf071  # Exclamation-triangle icon

source: |
  -- Force warning type
  type = "warning"
  title = title or "Warning"
  
  -- Use parent implementation
  local msg = message or ""
  if msg == "" then
    msg = "(Empty warning notification)"
  end
  
  -- Get the notification type
  local notification_type = "WARNING"
  
  -- Get optional title
  local header = title or "Warning"
  
  -- Calculate duration based on message length (warnings stay longer)
  local length = string.len(msg)
  local time = math.max(3.0, math.min(8.0, length * 0.08))
  
  -- Set color
  local color = "#FFA000F5"
  
  -- Send the notification
  Notify:message(msg, time, color, header, notification_type)
  
  -- Continue execution
  ${EXEC.exec_out}