description: "Base node for all array and table operations"
group: Array
name: Array
extends: Base/Node

theme:
  color: '#FF9800'
  height: 60
  width: 140
  icon: 0xf0cb  # List icon

edges:
  array:
    description: 'The array to operate on'
    direction: input
    type: list
  result:
    description: 'The resulting array'
    direction: output
    type: list
  length:
    description: 'Number of elements in the array'
    direction: output
    type: number
  is_empty:
    description: 'True if the array has no elements'
    direction: output
    type: boolean
  exec_in:
    description: 'Execution input'
    direction: input
    type: exec
  exec_out:
    description: 'Execution output'
    direction: output
    type: exec

source: |
  -- Ensure input is a table
  local arr = array
  if type(arr) ~= "table" then
    arr = {}
  end
  
  -- Calculate array properties
  local len = #arr
  
  -- Set outputs
  ${OUTPUT.result = arr}
  ${OUTPUT.length = len}
  ${OUTPUT.is_empty = len == 0}
  
  -- Continue execution
  ${EXEC.exec_out}