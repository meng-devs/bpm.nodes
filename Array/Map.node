description: "Creates a new array by transforming each element with a function"
group: Array
name: Map
extends: Array/Array

edges:
  array:
    description: 'The source array to map'
    direction: input
    type: list
    required: true
  mapper:
    description: 'Function node to process each element'
    direction: input
    type: exec
    required: true
  element:
    description: 'Current element being processed'
    direction: output
    type: any
  index:
    description: 'Index of current element'
    direction: output
    type: number
  mapped:
    description: 'Resulting transformed array'
    direction: output
    type: list

source: |
  -- Ensure input is a table
  local arr = array
  if type(arr) ~= "table" then
    arr = {}
  end
  
  -- Create a new array for the results
  local result_array = {}
  
  -- Process each element through the mapper function
  for i, element in ipairs(arr) do
    -- Set current element and index
    ${OUTPUT.element = element}
    ${OUTPUT.index = i}
    
    -- Call mapper function for this element
    ${EXEC.mapper}
    
    -- The mapper function should place its result in a global variable 
    -- we can read here, but this is a simplified implementation
    -- In a real implementation, there would be a way to capture the function's output
    
    -- Here we just copy the element for demonstration
    table.insert(result_array, element)
  end
  
  -- Set outputs
  ${OUTPUT.result = arr}       -- Original array (unchanged)
  ${OUTPUT.mapped = result_array} -- Transformed array
  ${OUTPUT.length = #arr}
  ${OUTPUT.is_empty = #arr == 0}
  
  -- Continue execution
  ${EXEC.exec_out}