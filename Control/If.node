description: "Executes one of two paths based on a boolean condition"
group: Control
name: If
extends: Control/Control

edges:
  condition:
    description: 'Boolean condition to evaluate'
    direction: input
    type: boolean
    required: true
  result:
    description: 'The result of the condition evaluation'
    direction: output
    type: boolean
  true_branch:
    description: 'Execution path if condition is true'
    direction: output
    type: exec
  false_branch:
    description: 'Execution path if condition is false'
    direction: output
    type: exec

source: |
  -- Evaluate the condition
  local result = condition == true
  
  -- Output the result
  ${OUTPUT.result = result}
  
  -- Branch based on the condition
  if result then
      ${EXEC.true_branch}
  else
      ${EXEC.false_branch}
  end
  
  -- Continue main execution flow
  ${EXEC.exec_out}
