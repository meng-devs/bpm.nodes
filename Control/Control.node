description: "Base node for all control flow operations"
group: Control
name: Control
extends: Base/Node

theme:
  color: '#eb3e31'
  height: 80
  width: 140
  icon: 0xf1c9  # Code branch icon

edges:
  exec_in:
    description: 'Execution input - begins the control flow'
    direction: input
    type: exec
  exec_out:
    description: 'Execution output - called after the control flow completes'
    direction: output
    type: exec